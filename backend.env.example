# ==========================================
# HostelEase Backend - Production & Cloud Deployment Env
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production

# 2. CORS - Allowed Frontend Origins
ALLOWED_ORIGINS=https://hostelease.vercel.app

# 3. Database Configuration - Firebase Cloud Firestore
# In AI Studio, this is auto-loaded from firebase-applet-config.json.
# On external hosts (Render, Vercel, Railway), configure these:
FIREBASE_PROJECT_ID=gen-lang-client-0567113793
FIREBASE_API_KEY=AIzaSyBeKKto-l5WK11KCV3kO5LdtTo3zNV-jxQ
FIREBASE_APP_ID=1:623261114671:web:8d398e440a40e5655fc1da
FIREBASE_AUTH_DOMAIN=gen-lang-client-0567113793.firebaseapp.com
FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-hostelease-158afa08-ae8d-4f1b-9d18-5cc8eadf7bfb
FIREBASE_STORAGE_BUCKET=gen-lang-client-0567113793.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=623261114671

# 4. Authentication - JSON Web Token (JWT)
JWT_SECRET=your_jwt_super_secret_production_key_change_me
JWT_EXPIRES_IN=24h

# 5. Media Storage - Cloudinary Config (Optional)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# 6. Artificial Intelligence - Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
