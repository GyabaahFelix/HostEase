# ==========================================
# HostelEase Backend - Render Deployment Env
# ==========================================

# 1. Server Configuration
# Usually injected automatically by Render, but can be set manually.
PORT=3000
NODE_ENV=production

# 2. CORS - Allowed Frontend Origins
# Comma-separated list of frontends allowed to access this API.
# Local development defaults are allowed if empty, but set this in production.
# Example: https://hostelease.vercel.app,https://hostelease-preview.vercel.app
ALLOWED_ORIGINS=https://hostelease.vercel.app

# 3. Database Configuration - MongoDB Atlas
# Replace with your connection string from MongoDB Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostelease?retryWrites=true&w=majority

# 4. Authentication - JSON Web Token (JWT)
# Secret key used for cryptographic session signature. Change this to a secure random string in production!
JWT_SECRET=your_jwt_super_secret_production_key_change_me
JWT_EXPIRES_IN=24h

# 5. Media Storage - Cloudinary Config
# Used for server-side upload and CDN hosting of hostel images.
# Get this from your Cloudinary Dashboard under API Environment Variable.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# 6. Artificial Intelligence - Google Gemini
# Injected automatically by AI Studio, but required on Render for smart features.
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
