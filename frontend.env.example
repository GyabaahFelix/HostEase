# ==========================================
# HostelEase Frontend - Vercel Deployment Env
# ==========================================

# 1. API Configuration
# Points to the Express backend hosted on Render. Do NOT include a trailing slash.
# For local development: http://localhost:3000
# For production: https://hostelease-backend.onrender.com
VITE_API_URL=https://hostelease-backend.onrender.com

# 2. Cloudinary Media Upload Configuration (Frontend Upload)
# If uploading directly from the browser using Cloudinary's unsigned upload presets.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
