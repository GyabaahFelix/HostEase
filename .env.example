# --- Server & Core Configuration ---
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=*

# --- Authentication ---
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# --- Firebase Cloud Firestore Configuration ---
# Note: In Google AI Studio, firebase-applet-config.json is auto-loaded.
# For Vercel, Railway, or standalone production deployment, supply these variables:
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# --- Optional Cloud Integrations ---
CLOUDINARY_URL=
GEMINI_API_KEY=
